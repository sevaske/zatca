ZATCA_ENV=sandbox
ZATCA_CREDENTIALS_DISK=local
ZATCA_CSR_PATH=zatca/certificate.csr
ZATCA_PRIVATE_KEY_PATH=zatca/private_key.pem
ZATCA_COMPLIANCE_CREDENTIALS_PATH=zatca/compliance_credentials.json
ZATCA_PRODUCTION_CREDENTIALS_PATH=zatca/production_credentials.json
ZATCA_LANGUAGE=en
ZATCA_CLEARANCE_ENABLED=true
ZATCA_HTTP_TIMEOUT=60
ZATCA_HTTP_CONNECT_TIMEOUT=10
